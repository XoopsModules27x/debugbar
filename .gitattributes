# Path-based git attributes — XOOPS module DevOps baseline.
# xoops-overlay:profile=core27
# https://git-scm.com/docs/gitattributes
# Stored with LF line endings, like everything else here.
# Normalize line endings.
* text=auto
*.php text eol=lf
# Keep development & CI files OUT of the release archive (git archive / GitHub release ZIP).
/.github                export-ignore
/.build                 export-ignore
/stubs                  export-ignore
/tests                  export-ignore
/testdata               export-ignore
# /docs                   export-ignore
/docs/00                export-ignore
/docs/00/**             export-ignore
/.editorconfig          export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php  export-ignore
/.php-cs-fixer.cache     export-ignore
/.scrutinizer.yml       export-ignore
/.xoops-overlay.json    export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan-bootstrap.php  export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/psalm.xml              export-ignore
/rector.php             export-ignore
/sonar-project.properties export-ignore
/.git-blame-ignore-revs export-ignore
/composer.lock          export-ignore
/.gitattributes         export-ignore
# CHANGELOG.md deliberately SHIPS, diverging from the module-devops baseline.
# It is the industry-standard location, and the About tab will read the release
# history from it once docs/changelog.txt is retired.
# /CHANGELOG.md           export-ignore
